# Public domain name pointing to this server (no scheme or trailing slash).
DOMAIN=sensai.example.com

# Email used by Caddy for HTTPS certificate notices.
ACME_EMAIL=admin@example.com

# Generate with: openssl rand -hex 32
# Hex avoids special characters that need URL encoding in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_a_random_64_character_hex_value

# Generate with: openssl rand -hex 48
SECRET_KEY=replace_with_a_random_secret_key

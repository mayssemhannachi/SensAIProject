# SensAI Docker Environment
# Copy this file to .env and fill in your values before running docker compose.

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=sensai_db
POSTGRES_USER=sensai
POSTGRES_PASSWORD=change_me_strong_password

# ─── FastAPI ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-key

# ─── Next.js ──────────────────────────────────────────────────
# For the hackathon demo on localhost:
NEXT_PUBLIC_API_URL=http://localhost:8000

# For a real deployment behind a domain:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
